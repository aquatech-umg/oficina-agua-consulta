# Copia este archivo como .env y reemplaza los valores.
# Estas son las claves de PRUEBA oficiales de hCaptcha: no protegen contra bots.
# Las claves reales van solo en tu .env local, que Git ignora.
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Base de datos (AQ-118). DB_PASSWORD no tiene valor por defecto: el servicio no arranca sin ella.
# Si corres el servicio dentro de Docker, "localhost" apunta al propio contenedor:
# usa DB_HOST=host.docker.internal para llegar a la replica publicada en el puerto 3307 de tu PC.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=oficina_agua
DB_USER=lectura
DB_PASSWORD=9182

